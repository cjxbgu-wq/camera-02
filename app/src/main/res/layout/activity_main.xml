<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="12dp"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- 预览/输出 Surface -->
    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 旋转选择 (对应 nativeConvertAndroid420ToABGR 的 rot=0/90/180/270) -->
    <RadioGroup
        android:id="@+id/rotGroup"
        android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <RadioButton android:id="@+id/r0"   android:text="0°"   android:checked="true"/>
        <RadioButton android:id="@+id/r90"  android:text="90°"/>
        <RadioButton android:id="@+id/r180" android:text="180°"/>
        <RadioButton android:id="@+id/r270" android:text="270°"/>
    </RadioGroup>

    <!-- 功能按钮, 一一对应 4 个 JNI 导出 -->
    <Button android:id="@+id/btnConvert"  android:text="YUV->ABGR (convert)"  android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnRotateYUV" android:text="旋转YUV平面 (rotateYUV)" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnShift"     android:text="丢帧补偿 (shiftPixel)" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnJpeg"      android:text="写入JPEG (writeJpeg)"   android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <CheckBox android:id="@+id/flip" android:text="水平翻转 (flip)" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
